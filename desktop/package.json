{
  "name": "ligule-desktop",
  "private": true,
  "version": "0.0.5",
  "description": "Ligule Electron desktop application",
  "homepage": "https://github.com/xswt442-cmd/ligule#readme",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "node ./dev.mjs",
    "build": "node ./build.mjs",
    "build:dir": "node ./build.mjs --dir",
    "build:win": "node ./build.mjs --win nsis",
    "build:linux": "node ./build.mjs --linux appimage deb",
    "build:mac": "node ./build.mjs --mac dmg"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "builder-util": "26.15.3"
  }
}
