{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ligule",
  "version": "0.0.1",
  "identifier": "app.ligule.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ligule",
        "width": 1080,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
