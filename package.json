{
  "name": "ligule",
  "version": "0.0.1",
  "description": "占位版本，开发中。自建 agent harness：内核不提供任何工具，一切能力皆插件。Placeholder, under development. A self-built agent harness: the kernel ships no tools of its own; every capability is a plugin.",
  "type": "module",
  "bin": {
    "ligule": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "modes",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "check-pack": "node scripts/check-pack.js",
    "build-rg": "node scripts/build-rg-packages.js"
  },
  "engines": {
    "node": ">=24"
  },
  "author": "xswt442-cmd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xswt442-cmd/ligule.git"
  },
  "homepage": "https://github.com/xswt442-cmd/ligule#readme",
  "bugs": {
    "url": "https://github.com/xswt442-cmd/ligule/issues"
  },
  "keywords": [
    "agent",
    "harness",
    "agent-harness",
    "placeholder"
  ],
  "dependencies": {
    "smol-toml": "^1.9.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-pwsh": "0.38.1",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  }
}
