# testplace
testplace

# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Build & coverage output
dist/
build/
coverage/

# Package artifacts
*.tgz
*.tar.gz
.npm/

# 平台包内容由 scripts/build-rg-packages.js 拉取生成：二进制与它自带的许可文本都不进版本控制
packages/*/rg
packages/*/rg.exe
packages/*/LICENSE-MIT
packages/*/UNLICENSE
packages/*/COPYING
packages/*/RIPGREP-VERSION

# Environment & secrets
.env
.env.*
!.env.example
# 一次运行的会话记录与本地配置都在这儿（D8、D11），没有该签进去的东西
.ligule/

# Editors & OS
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
*~
*.bak
*.orig

# Agent tooling
.workbuddy/
.claude/
.codex/
.cursor/
.continue/
.aider*
*.local.md
